{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NMOS process flow v1",
  "type": "object",
  "required": [
    "version",
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "title",
          "card",
          "operations"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "card": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 4
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "equipmentId",
                "modelId",
                "parameters",
                "measurementRequired"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "equipmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "modelId": {
                  "type": "string",
                  "minLength": 1
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "key",
                          "label",
                          "unit",
                          "target",
                          "min",
                          "max",
                          "tolerance"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "unit": {
                            "type": "string"
                          },
                          "target": {
                            "type": "number"
                          },
                          "min": {
                            "type": "number"
                          },
                          "max": {
                            "type": "number"
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "key",
                          "label",
                          "unit",
                          "target",
                          "options"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "unit": {
                            "type": "string"
                          },
                          "target": {
                            "type": "string"
                          },
                          "options": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "measurementRequired": {
                  "type": "boolean"
                },
                "measurementEquipmentId": {
                  "type": "string"
                },
                "verification": {
                  "enum": [
                    "검증 필요",
                    "검증 완료"
                  ]
                },
                "thicknessToleranceFraction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "autoAdvance": {
                  "type": "boolean"
                },
                "acceptDefects": {
                  "type": "boolean"
                },
                "measurementType": {
                  "enum": [
                    "pattern",
                    "etch",
                    "film",
                    "deposition",
                    "device"
                  ]
                },
                "material": {
                  "enum": [
                    "oxide",
                    "poly",
                    "ild",
                    "metal"
                  ]
                },
                "photoGroup": {
                  "enum": [
                    "active",
                    "gate",
                    "contact",
                    "metal"
                  ]
                },
                "targetThicknessNm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "testConditions": {
                  "type": "object",
                  "required": [
                    "temperatureK",
                    "vdsV",
                    "vgMinV",
                    "vgMaxV",
                    "samples"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "temperatureK": {
                      "type": "number",
                      "minimum": 300,
                      "maximum": 300
                    },
                    "vdsV": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 5
                    },
                    "vgMinV": {
                      "type": "number",
                      "minimum": 0
                    },
                    "vgMaxV": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 5
                    },
                    "samples": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 501
                    }
                  }
                },
                "specification": {
                  "type": "object",
                  "required": [
                    "vtToleranceV",
                    "ionToleranceFraction",
                    "vtHardToleranceV",
                    "ionHardToleranceFraction",
                    "gradeCutoffs"
                  ],
                  "properties": {
                    "vtToleranceV": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "ionToleranceFraction": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "vtHardToleranceV": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "ionHardToleranceFraction": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "gradeCutoffs": {
                      "type": "object",
                      "required": [
                        "S",
                        "A",
                        "B"
                      ],
                      "properties": {
                        "S": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "A": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "B": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "measurementRequired": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "measurementEquipmentId"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
